int main() {
    int i = 0;
    int sum = 0;
    while (i < 5) {
        i++;
        if (i == 3) {
            continue;
        }
        if (i == 5) {
            break;
        }
        sum = sum + i;
    }
    for (int j = 0; j < 3; j++) {
        sum = sum + j;
    }
    do {
        sum = sum - 1;
    } while (sum > 0);
    switch (i) {
        case 1:
            sum = 1;
            break;
        default:
            sum = 0;
    }
    goto done;
done:
    return sum;
}
