int main() {
    int i = 0, total = 0;
    for (i = 0; i < 8; i++) { if (i == 2) continue; total += i; }
    while (i > 0) { i--; if (i == 4) break; }
    do { total++; } while (total < 20);
    switch (i) { case 0: total += 1; break; case 1: total += 2; break; default: total += 3; }
    return total;
}
