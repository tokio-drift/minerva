int classify(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

int main() {
    int i;
    for (i = 0; i < 10; i++) {
        if (i == 5) continue;
        if (i == 8) break;
    }

    int j = 0;
    while (j < 5) {
        j++;
    }

    int k = 0;
    do {
        k++;
    } while (k < 3);

    int m = 0;
    do {
        m++;
    } until (m >= 3);

    switch (i) {
        case 1:
            i = 100;
            break;
        case 2:
            i = 200;
            break;
        default:
            i = -1;
    }

    goto end;
end:
    return 0;
}
