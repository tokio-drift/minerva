int classify(int value) {
    if (value < 0) return -1;
    else if (value == 0) return 0;
    else return 1;
}
int dense(int value) {
    switch (value) {
        case 0: return 10;
        case 1: return 11;
        case 2: return 12;
        case 3: return 13;
        case 4: return 14;
        case 5: return 15;
        default: return -1;
    }
}
int sparse(int value) {
    switch (value) {
        case -100: return 1;
        case -10: return 2;
        case 0: return 3;
        case 100: return 4;
        case 1000: return 5;
        case 10000: return 6;
        default: return -1;
    }
}
// Show each loop form, switch fallthrough and an explicit jump.
int main() {
    printf("=== Control flow ===\n");
    printf("if/else: %d %d %d\n", classify(-5), classify(0), classify(5));
    int total = 0;
    for (int i = 0; i < 6; i++) {
        if (i == 2) continue;
        if (i == 5) break;
        total += i;
    }
    printf("for with continue/break: total=%d\n", total);
    int count = 0;
    while (count < 3) count++;
    printf("while: count=%d\n", count);
    do { count--; } while (count > 1);
    printf("do-while: count=%d\n", count);
    do { count++; } until (count >= 3);
    printf("do-until: count=%d\n", count);
    switch (1) {
        case 0:
        case 1: { printf("switch reached a stacked case\n"); }
        case 2: { printf("switch fell through, then broke\n"); break; }
        default: printf("default\n");
    }
    printf("dense switch: %d; sparse switch: %d; default: %d\n", dense(4), sparse(1000), sparse(7));
    goto finished;
    printf("unreachable\n");
    finished: printf("goto reached its label\n");
    return 0;
}
