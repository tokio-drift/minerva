int choose(int value) {
    switch (value) {
        case -3: return 10;
        case -2: return 11;
        case 0: return 12;
        case 1: return 13;
        case 2: return 14;
        case 3: return 15;
        default: return 20;
    }
}
int main() {
    return choose(-3) == 10 && choose(3) == 15 && choose(-1) == 20 && choose(50) == 20 ? 0 : 1;
}
