struct Box { int value; };
int &identity(int &value) { value++; return value; }
const int &read(const int &value) { return value; }
char &first(char &value) { return value; }
typedef int &(*Picker)(int &);
class Counter {
public:
    int value;
    int &get() { return value; }
    void add(int &amount) { value += amount; }
};
// Check aliases through ordinary calls, function pointers and methods.
int main() {
    int value = 1;
    int &alias = value;
    alias = 3;
    ++alias;
    alias++;
    int *address = &alias;
    int values[2] = {5, 6};
    int &element = values[1];
    element += 2;
    struct Box box;
    box.value = 7;
    int &field = box.value;
    ++field;
    char letter = 'a';
    char &character = first(letter);
    character = 'b';
    int &returned = identity(alias);
    returned = 9;
    identity(value) = 10;
    Picker fn = identity;
    int &indirect = fn(value);
    indirect = 12;
    int *pointer = &value;
    int *&pointerAlias = pointer;
    pointerAlias = &values[0];
    *pointerAlias = 13;
    const int &view = value;
    int before = read(view);
    { int &alias = values[0]; alias = 14; }
    int (*change)(int &);
    change = [](int &argument) { argument++; return argument; };
    change(value);
    Counter counter;
    counter.value = 2;
    counter.add(value);
    counter.get() = 20;
    return *address + values[0] + values[1] + box.value + letter + sizeof(character) + before + counter.value;
}
