int choose(int value) {
    switch (value) {
        case -100: return 1;
        case -10: return 2;
        case 0: return 3;
        case 17: return 4;
        case 500: return 5;
        case 9000: return 6;
        default: return 9;
    }
}
int main() {
    return choose(-100) == 1 && choose(17) == 4 && choose(9000) == 6 && choose(-11) == 9 ? 0 : 1;
}
