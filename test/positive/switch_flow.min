int hits;
int pick() { hits++; return 1; }
int main() {
    int sum = 0;
    switch (pick()) {
        case 0:
        case 1: { sum += 2; }
        case 2: { sum += 3; break; }
        default: sum = 99;
    }
    switch (4) { case 1: sum = 99; }
    for (int i = 0; i < 3; i++) {
        switch (i) {
            case 0: continue;
            case 1: {
                switch (i + 1) { case 2: { sum += 4; break; } default: sum = 99; }
                break;
            }
            default: sum += 5;
        }
    }
    return sum == 14 && hits == 1 ? 0 : 1;
}
