struct Inner { char tag; int value; };
struct Outer { struct Inner inner; short tail; int values[2]; };
union Choice { int value; char byte; };
class BaseItem { public: char tag; };
class Item : public BaseItem { public: int value; };
struct Outer globalOuter = {{'g', 7}, 2, {8}};
union Choice globalChoice = {11};
Item globalItem = {'i', 12};
int next(int value) { return value + 1; }
int main() {
    struct Outer local = {{'l', next(3)}, 5, {6}};
    union Choice choice = {9};
    Item item = {'x', 10};
    static struct Inner persistent = {'p', 13};
    static Item stored = {'s', 14};
    return local.inner.value + local.values[1] + choice.value + item.value +
        globalOuter.inner.value + globalOuter.values[1] + globalChoice.value + globalItem.value + persistent.value + stored.value;
}
