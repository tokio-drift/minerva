int main() {
    int a = 12;
    int b = 5;
    int remainder = a % b;
    int masked = a & b;
    int combined = a | b;
    int exclusive = a ^ b;
    int inverted = ~a;
    int shifted = a << b;
    int moved = a >> b;
    int negated = -a;
    int truth = !a;
    return remainder + masked + combined + exclusive + inverted + shifted + moved + negated + truth;
}
